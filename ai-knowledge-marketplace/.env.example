# Copy to .env.local for local development. Never commit real secrets.

# --- Database (Milestone 1: connection layer only) ---
DATABASE_URL=postgres://user:password@localhost:5432/ai_knowledge_marketplace

# --- Auth (Milestone 3: Auth.js / next-auth, credentials + JWT sessions) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32+-character-secret
# Recommended in production (canonical URL for callback resolution); not
# required in local dev.
# NEXTAUTH_URL=https://your-deployed-domain.example

# --- Object storage (selected in a later milestone) ---
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Payments (Milestone 15: Stripe Checkout, confirmed with the user —
# provider/currency were an explicit business decision per the kickoff
# review, not an engineering default) ---
# Optional — the app runs fine without it; only checkout-session creation
# needs it, and fails that one path closed (never fabricates a checkout
# URL) when unset. Get one from dashboard.stripe.com/apikeys (use a test
# secret key, sk_test_..., outside production).
# STRIPE_SECRET_KEY=
# Optional, independently of the above — required for webhook signature
# verification specifically. From the endpoint's settings in the Stripe
# dashboard (or `stripe listen` in local dev). Webhooks fail closed
# (rejected, never processed unverified) when unset.
# STRIPE_WEBHOOK_SECRET=

# --- AI (Milestone 7: Claude Haiku 4.5 via the Anthropic API) ---
# Optional — the app runs fine without it; only `npm run worker:audit`
# needs it, and audit jobs simply fail closed (never fabricate a result)
# when it's unset. Get one from console.anthropic.com (separate from any
# Claude Pro/Max subscription — see the kickoff conversation).
# ANTHROPIC_API_KEY=

NODE_ENV=development
