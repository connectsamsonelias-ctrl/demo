AVIATION_RAG_API_KEY=change-me-to-a-long-random-string
AVIATION_RAG_DB_PATH=./aviation_vector_db
AVIATION_RAG_SNAG_HISTORY_PATH=./data/snag_history.json

# Optional local LLM generation (off by default - see README Stage F).
# Set LLM_ENABLED=true and run with `docker compose --profile llm up --build`
# to also start the ollama container. Default model is gemma2:2b (Google) -
# swapped from an earlier Qwen2.5 default for country-of-origin reasons in
# a defense-context review, see docs/failure-modes.md. Swap OLLAMA_MODEL to
# use a different model (e.g. a locally-hosted BharatGen build once its
# license is confirmed).
LLM_ENABLED=false
OLLAMA_MODEL=gemma2:2b
# Measured ~2 minutes per answer on a low-power CPU-only laptop - raise
# further if you still see timeouts on slower hardware.
OLLAMA_TIMEOUT_SECONDS=300
