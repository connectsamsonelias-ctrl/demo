# Bakes a small local LLM into the Ollama image at BUILD time, so the
# running container never needs to download anything - same air-gap
# principle as the embedding model bake-in in the main Dockerfile.
#
# Default model: qwen2.5:1.5b-instruct (Apache 2.0 license, ~1GB). Chosen
# for being small enough to run on modest CPU-only hardware while still
# giving reasonable answer quality. Swap OLLAMA_MODEL below (and the
# matching env var in docker-compose.yml) to use a different model -
# including a locally-hosted BharatGen build, once its GGUF conversion
# and license terms are sorted out. No application code needs to change
# for that swap - see app/llm.py.
FROM ollama/ollama:latest

ARG OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Start the server in the background just long enough to pull the model,
# then let the RUN step end (the temporary server process exits with it -
# the downloaded model files persist in this image layer regardless).
RUN (ollama serve &) && \
    sleep 5 && \
    ollama pull ${OLLAMA_MODEL} && \
    echo "Baked in model: ${OLLAMA_MODEL}"

EXPOSE 11434
